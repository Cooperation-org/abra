# Copy to impl/.env (gitignored).

# Backend. Unset: PostgreSQL from PG_* below.
# SQLite file instead (four slashes for an absolute path, ~ expands):
# ABRA_DATABASE_URL=sqlite:///~/.abra/abra.db
# Or a full PostgreSQL URL:
# ABRA_DATABASE_URL=postgresql://user:pass@host:5432/abra

PG_HOST=10.0.0.100
PG_PORT=5432
PG_USER=cobox
PG_PASSWORD=your_password_here
PG_DATABASE=abra

# Default scope. Unset: `scope:` in ~/.abra/sources.yaml, else your login name.
# ABRA_SCOPE=

# Provenance for writes. Unset: urn:abra:local:<login name>.
# ABRA_WRITER_URI=

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

ANTHROPIC_API_KEY=your_api_key_here
